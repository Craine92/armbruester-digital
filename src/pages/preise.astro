---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PricingSection from '@/components/PricingSection.astro';
import PricingCard from '@/components/PricingCard.astro';
import CallToAction from '@/components/CallToAction.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { carePackages } from '@/data/pricing';
---
<BaseLayout title="Preise | Webdesign-Pakete von Armbrüster Digital" description="Transparente Orientierung für Websites und digitale Betreuung von Unternehmen, Selbstständigen, Handwerk, Gastronomie und Praxen." path="/preise/" breadcrumbs={[{name:'Startseite',path:'/'},{name:'Preise',path:'/preise/'}]}>
  <section class="page-hero"><div class="container page-hero__inner"><div><p class="eyebrow">Preise</p><h1>Planbar starten. <em>Individuell wachsen.</em></h1></div><div class="page-hero__intro"><strong>Transparente Orientierung.</strong><p>Alle genannten Preise sind ab-Preise und werden nach einem persönlichen Erstgespräch konkretisiert.</p></div></div></section>
  <PricingSection />
  <section class="content-section lavender-section care-section" id="betreuung" aria-labelledby="care-title"><div class="container"><div id="care-title"><SectionHeading eyebrow="Betreuung & Weiterentwicklung" title="Betreuung, die zu Ihrem Alltag passt." text="Auch nach der Veröffentlichung bleibe ich auf Wunsch an Ihrer Seite. Wählen Sie zwischen regelmäßiger Betreuung oder flexiblen Einzeländerungen – passend zu Ihrem tatsächlichen Bedarf." /></div><div class="pricing-grid pricing-grid--care">{carePackages.map((item) => <PricingCard item={item} />)}</div></div></section>
  <CallToAction compact />
</BaseLayout>

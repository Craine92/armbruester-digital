---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CallToAction from '@/components/CallToAction.astro';
import { services } from '@/data/services';
import Button from '@/components/Button.astro';

const extended = [
  { id: 'strategie', number: '01', title: 'Strategie und Konzeption', lead: 'Vor dem Design entsteht ein klarer Plan, der Unternehmen, Zielgruppen, Inhalte und die gewünschten nächsten Schritte zusammenbringt.', items: services[0].benefits },
  { id: 'webdesign', number: '02', title: 'Webdesign und Website-Erstellung', lead: 'Eine gute Website macht Ihr Angebot schnell verständlich, schafft Vertrauen und führt Besucher ohne Umwege zum nächsten Schritt.', items: services[1].benefits },
  { id: 'seo', number: '03', title: 'SEO und Google-Auffindbarkeit', lead: 'Saubere Technik und klar gegliederte Inhalte helfen Suchmaschinen, Ihr Angebot richtig einzuordnen und potenzielle Kunden zu erreichen.', items: services[2].benefits },
  { id: 'social', number: '04', title: 'Social Media und digitale Präsenz', lead: 'Website, Profile und Inhalte erhalten eine einheitliche Richtung, damit Ihr Unternehmen über verschiedene Kontaktpunkte wiedererkennbar auftritt.', items: services[3].benefits },
  { id: 'digitale-praesenz', number: '05', title: 'Domain, E-Mail und technische Einrichtung', lead: 'Domain, professionelle E-Mail-Adressen, Hosting und Veröffentlichung werden nachvollziehbar zu einer zuverlässigen Basis verbunden.', items: ['Domain- und DNS-Einrichtung', 'Professionelle E-Mail-Adressen', 'SSL-Verschlüsselung', 'Hosting und Deployment', 'Sitemap und Indexierung'] },
  { id: 'google', number: '06', title: 'Google-Unternehmensprofil', lead: 'Ein gepflegtes Unternehmensprofil macht wichtige Informationen wie Standort und Kontaktmöglichkeiten direkt auffindbar.', items: ['Grundlegende Einrichtung', 'Einheitliche Unternehmensdaten', 'Verknüpfung mit Website und Kontakt', 'Hinweise zur eigenständigen Pflege'] },
  { id: 'betreuung', number: '07', title: 'Pflege und Weiterentwicklung', lead: 'Nach dem Start kann Ihr Auftritt auf Wunsch angepasst und erweitert werden, wenn sich Leistungen, Inhalte oder Anforderungen verändern.', items: services[4].benefits }
];
---
<BaseLayout title="Webdesign, SEO & Social Media | Leistungen" description="Strategie, Website-Erstellung, SEO, Social Media und digitale Betreuung aus einer Hand – persönlich aus Lübeck und deutschlandweit umgesetzt." path="/leistungen/" breadcrumbs={[{name:'Startseite',path:'/'},{name:'Leistungen',path:'/leistungen/'}]}>
  <section class="page-hero"><div class="container page-hero__inner"><div><p class="eyebrow">Rundum-sorglos-Leistungen</p><h1>Ein digitaler Unternehmensauftritt, bei dem <em>alles zusammenspielt.</em></h1></div><p class="page-hero__intro"><strong>Vom Konzept bis zur Weiterentwicklung.</strong> Sie erhalten eine Lösung, die zu Ihrem Unternehmen, Ihrem Alltag und Ihren Zielen passt.</p></div></section>
  <section class="content-section"><div class="container"><SectionHeading title="Nicht mehr Technik als nötig. Aber alles, was wichtig ist." text="Die Leistungen werden deutschlandweit so kombiniert, dass ein stimmiger, wartbarer und professioneller Auftritt entsteht." />
    <div class="services-grid">{extended.map((item) => <article class="service-card reveal" id={item.id}><span class="service-card__number">{item.number}</span><h3>{item.title}</h3><p>{item.lead}</p><ul>{item.items.map((benefit) => <li>{benefit}</li>)}</ul></article>)}</div>
    <div class="prose service-scope"><h2>Individuell vereinbart</h2><p>Welche Bausteine für Ihr Unternehmen sinnvoll sind, klären wir im persönlichen Gespräch. Der konkrete Leistungsumfang, Zeitrahmen und Preis werden individuell vereinbart und vor Projektbeginn transparent festgehalten.</p><p>Suchmaschinenoptimierung schafft eine saubere Grundlage für Sichtbarkeit. Bestimmte Positionen in Suchergebnissen können und werden nicht garantiert.</p><p><Button href="/webdesign-luebeck/" variant="secondary">Mehr zu Webdesign in Lübeck</Button></p></div>
  </div></section><CallToAction compact />
</BaseLayout>

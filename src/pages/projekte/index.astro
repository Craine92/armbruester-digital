---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProjectFeature from '@/components/ProjectFeature.astro';
import CallToAction from '@/components/CallToAction.astro';
import { projects } from '@/data/projects';
---
<BaseLayout title="Referenzprojekt | Armbrüster Digital" description="Das realisierte Webdesign-Referenzprojekt von Armbrüster Digital: individuell entwickelt, responsive umgesetzt und klar präsentiert." path="/projekte/" breadcrumbs={[{name:'Startseite',path:'/'},{name:'Referenzprojekt',path:'/projekte/'}]}>
  <section class="page-hero"><div class="container page-hero__inner"><div><p class="eyebrow">Referenzprojekt</p><h1>Ein digitaler Auftritt mit <em>eigenem Charakter.</em></h1></div><p class="page-hero__intro"><strong>Individuell statt gleichförmig.</strong> Die realisierte Website zeigt, wie Gestaltung, Struktur und Technik zu einem stimmigen Unternehmensauftritt zusammenfinden.</p></div></section>
  <section class="content-section"><div class="container"><SectionHeading title="Ein realisiertes Projekt im Detail." text="Die Unternehmenswebsite für Dirk Kuhlmann Garten- und Landschaftsbau gibt konkrete Einblicke in Konzeption, Gestaltung und responsive Umsetzung." />
    <div class="project-list">{projects.map((project, index) => <ProjectFeature project={project} index={index} />)}</div>
  </div></section><CallToAction compact />
</BaseLayout>
